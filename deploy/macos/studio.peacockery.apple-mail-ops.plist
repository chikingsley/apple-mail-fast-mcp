<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>studio.peacockery.apple-mail-ops</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>uv</string>
    <string>run</string>
    <string>--locked</string>
    <string>--no-dev</string>
    <string>apple-mail-ops</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>APPLE_MAIL_MCP_APPLESCRIPT_SOCKET</key>
    <string>__APPLE_MAIL_MCP_APPLESCRIPT_SOCKET__</string>
    <key>APPLE_MAIL_MCP_JUNK_CONFIG</key>
    <string>__MAIL_OPS_CONFIG__</string>
    <key>APPLE_MAIL_MCP_OPS_STATUS</key>
    <string>__MAIL_OPS_STATUS__</string>
    <key>PATH</key>
    <string>__HOME__/.config/apple-mail-fast-mcp/bin:__HOME__/.local/bin:__HOME__/.opencode/bin:__HOME__/.kimi-code/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/mail-ops.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/mail-ops.err.log</string>
</dict>
</plist>
